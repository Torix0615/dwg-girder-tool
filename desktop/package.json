{
  "name": "girder-tool",
  "private": true,
  "version": "1.1.2",
  "description": "골조·거더·보 생성기 데스크탑 (Electron 셸)",
  "main": "main.js",
  "author": "taeju",
  "scripts": {
    "start": "electron .",
    "icons": "python scripts/make_icon.py",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.taeju.girdertool",
    "productName": "GirderTool",
    "artifactName": "GirderTool-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**",
      "lib/**",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "../dist_build/pkg/app",
        "to": "engine/app",
        "filter": [
          "**/*",
          "!__pycache__"
        ]
      },
      {
        "from": "../dist_build/pkg/runtime",
        "to": "engine/runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
